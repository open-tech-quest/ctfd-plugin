{
  "name": "open-tech-quest-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit && npm test",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build",
    "format": "prettier --write src public vite.config.ts index.html package.json tsconfig.json",
    "format:check": "prettier --check src public vite.config.ts index.html package.json tsconfig.json"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
